# Строка подключения к PostgreSQL (на Render подставляется автоматически из render.yaml)
DATABASE_URL="postgresql://user:password@localhost:5432/fiesta"

# Секрет для подписи сессии админки: любая длинная случайная строка (openssl rand -base64 32)
AUTH_SECRET=""

# Первый администратор создаётся seed-скриптом из этих переменных
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
