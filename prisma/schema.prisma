generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  image     String?
  sort      Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id              String         @id @default(cuid())
  legacyId        Int?           @unique
  slug            String         @unique
  name            String
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price           Int
  oldPrice        Int?
  description     String
  fullDescription String         @default("")
  specs           Json           @default("[]")
  images          ProductImage[]
  inStock         Boolean        @default(true)
  isNew           Boolean        @default(false)
  isHit           Boolean        @default(false)
  isShowroom      Boolean        @default(false)
  condition       String?
  discountReason  String?
  isLast          Boolean        @default(false)
  published       Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([categoryId])
  @@index([isShowroom, published])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String?
  sort      Int     @default(0)
  // Загруженный через админку файл (WebP) хранится прямо в базе
  blob      ImageBlob? @relation(fields: [blobId], references: [id], onDelete: SetNull)
  blobId    String?    @unique

  @@index([productId])
}

model ImageBlob {
  id        String        @id @default(cuid())
  data      Bytes
  mime      String
  width     Int
  height    Int
  image     ProductImage?
  createdAt DateTime      @default(now())
}

model Review {
  id          String   @id @default(cuid())
  name        String
  city        String?
  rating      Int
  text        String
  productName String?
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Order {
  id           String      @id @default(cuid())
  number       Int         @unique @default(autoincrement())
  customerName String
  phone        String
  email        String?
  address      String?
  comment      String?
  delivery     String      @default("delivery")
  total        Int
  status       OrderStatus @default(NEW)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  price     Int
  qty       Int
}

enum OrderStatus {
  NEW
  CONFIRMED
  DELIVERING
  DONE
  CANCELLED
}

model Lead {
  id        String   @id @default(cuid())
  type      String
  name      String
  phone     String
  email     String?
  message   String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
